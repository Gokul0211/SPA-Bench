{
  "openapi": "3.0.3",
  "info": {
    "title": "Angular Permit-to-Work API",
    "description": "REST API used by the Permit-to-Work web client.",
    "version": "1.0.0",
    "contact": {
      "name": "Platform API team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "API server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PermitType": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "HOT_WORK"
          },
          "label": {
            "type": "string",
            "example": "Hot Work Permit"
          }
        }
      },
      "WorkOrder": {
        "type": "object",
        "properties": {
          "workOrderId": {
            "type": "string"
          },
          "workSiteId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "CLOSED"
            ]
          },
          "supervisorId": {
            "type": "integer"
          },
          "hazardLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatePermitRequest": {
        "type": "object",
        "required": [
          "workSiteId",
          "startDate",
          "endDate",
          "hazardLevel",
          "supervisorId"
        ],
        "properties": {
          "workSiteId": {
            "type": "string",
            "description": "Unique work site identifier"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Permit start date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Permit end date"
          },
          "hazardLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "supervisorId": {
            "type": "integer",
            "description": "Employee ID of the responsible supervisor"
          }
        }
      },
      "PermitDetails": {
        "type": "object",
        "properties": {
          "permitId": {
            "type": "string"
          },
          "permitType": {
            "type": "string"
          },
          "workSiteId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_APPROVAL",
              "APPROVED",
              "ACTIVE",
              "CLOSED",
              "REJECTED"
            ]
          },
          "hazardLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "supervisorId": {
            "type": "integer"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "approvedBy": {
            "type": "string"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT access token"
          },
          "expiresIn": {
            "type": "integer",
            "example": 28800
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "unitPrice": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "LegacyReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Form-based login",
        "description": "Exchange username and password for a bearer token.",
        "operationId": "login",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/rc_permit/getPermitType": {
      "get": {
        "summary": "List permit type codes",
        "description": "List the permit type codes.",
        "operationId": "getPermitType",
        "tags": [
          "Permits"
        ],
        "responses": {
          "200": {
            "description": "Array of permit type codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "permitTypes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PermitType"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/rc_permit/getWorkOrder": {
      "get": {
        "summary": "Retrieve a work order by ID",
        "description": "Fetch a work order by id.",
        "operationId": "getWorkOrder",
        "tags": [
          "Permits"
        ],
        "parameters": [
          {
            "name": "workOrderId",
            "in": "query",
            "required": true,
            "description": "Unique work order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Work order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              }
            }
          },
          "400": {
            "description": "workOrderId missing"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/rc_permit/createPermit": {
      "post": {
        "summary": "Create a new permit",
        "description": "Create a permit-to-work request.",
        "operationId": "createPermit",
        "tags": [
          "Permits"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePermitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Permit created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermitDetails"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/rc_permit/getPermitDetails": {
      "get": {
        "summary": "Get full permit details",
        "description": "Fetch the full record of one permit.",
        "operationId": "getPermitDetails",
        "tags": [
          "Permits"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Permit details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermitDetails"
                }
              }
            }
          },
          "400": {
            "description": "id missing"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/admin/legacy-reports": {
      "get": {
        "summary": "List legacy admin reports",
        "description": "List archived reports (administrators only).",
        "operationId": "getLegacyReports",
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "List of legacy reports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reports": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LegacyReport"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin role required"
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "summary": "List orders (legacy v1)",
        "description": "List orders (v1 format).",
        "operationId": "listOrdersV1",
        "tags": [
          "Orders"
        ],
        "responses": {
          "200": {
            "description": "Legacy orders list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_version": {
                      "type": "string"
                    },
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v2/orders": {
      "get": {
        "summary": "List orders (v2 with pagination)",
        "description": "List orders with line items (v2 format).",
        "operationId": "listOrdersV2",
        "tags": [
          "Orders"
        ],
        "responses": {
          "200": {
            "description": "Paginated orders list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    },
                    "pagination": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  }
}
