{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPABench ground truth (v3)",
  "description": "Built by build_manifest.py from apps/*/manifest-partial.json. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated",
    "summary",
    "apps"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "$ref": "#/definitions/Summary"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/App"
      }
    }
  },
  "definitions": {
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apps",
        "endpoints",
        "test_cases",
        "distinct_method_paths",
        "distinct_paths",
        "assets",
        "auth_required",
        "security_relevant",
        "by_kind",
        "by_method",
        "by_reachability",
        "by_discovery_class"
      ],
      "properties": {
        "apps": {
          "type": "integer",
          "minimum": 0
        },
        "endpoints": {
          "type": "integer",
          "minimum": 0
        },
        "test_cases": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_method_paths": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_paths": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        },
        "auth_required": {
          "type": "integer",
          "minimum": 0
        },
        "security_relevant": {
          "type": "integer",
          "minimum": 0
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_method": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_reachability": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_discovery_class": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "App": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "framework",
        "framework_version",
        "build_tool",
        "port",
        "origin",
        "api_hosts",
        "external_hosts",
        "source_maps_exposed",
        "auth_method",
        "description",
        "endpoint_count",
        "test_case_count",
        "endpoints",
        "assets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "framework": {
          "enum": [
            "angular",
            "react",
            "vue",
            "nextjs"
          ]
        },
        "framework_version": {
          "type": "string",
          "description": "framework the hand-built bundle emulates"
        },
        "build_tool": {
          "enum": [
            "angular-cli-webpack",
            "webpack5-module-federation",
            "vite",
            "nuxt",
            "nextjs-compiler"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "origin": {
          "type": "string",
          "pattern": "^https?://"
        },
        "api_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "host:port values that reach this app's API (its origin, proxied and direct backends)"
        },
        "external_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "non-routable hosts the client references (staging, internal IPs)"
        },
        "source_maps_exposed": {
          "type": "boolean"
        },
        "auth_method": {
          "enum": [
            "form",
            "bearer",
            "totp"
          ]
        },
        "description": {
          "type": "string"
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Endpoint"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Asset"
          }
        }
      }
    },
    "Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "method",
        "kind",
        "test_case",
        "discovery_class",
        "evidence",
        "present_in",
        "exclusive",
        "reachability",
        "auth_required",
        "auth_method",
        "parameters",
        "security_relevant",
        "security_finding_type",
        "source_file",
        "minified_location",
        "discovery_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EP-[A-Z](-[A-Z]+)?-\\d{3}$"
        },
        "url": {
          "type": "string",
          "pattern": "^(https?|wss?)://"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "WS",
            "GRAPHQL"
          ]
        },
        "kind": {
          "enum": [
            "rest",
            "websocket",
            "graphql"
          ]
        },
        "test_case": {
          "type": "boolean",
          "description": "one of the hand-designed technique cases (vs. the rest of the client surface)"
        },
        "design_technique": {
          "enum": [
            "script_tag_standard",
            "html_attr_onclick",
            "html_attr_ng_include",
            "html_attr_formaction",
            "link_preload",
            "link_modulepreload",
            "dynamic_import_inline",
            "web_worker_constructor",
            "noscript_tag",
            "commented_script",
            "module_federation_remote_entry",
            "module_federation_html_parse",
            "sourcemap_probe_standard",
            "sourcemap_url_directive",
            "ts_service_file_recovery",
            "environment_ts_recovery",
            "jsx_source_recovery",
            "sourcemap_restricted",
            "backend_sourcemap_recovery",
            "auth_service_recovery",
            "url_concat_direct",
            "url_template_literal",
            "url_variable_based",
            "url_object_property_chain",
            "url_service_method_delegation",
            "url_array_assembly",
            "url_conditional_feature_flag",
            "inter_proc_constructor_single",
            "inter_proc_constructor_multi",
            "inter_proc_factory_return",
            "obfuscated_string_array",
            "inter_proc_cycle_detection",
            "httpclient_get",
            "httpclient_post",
            "httpclient_put",
            "httpclient_patch",
            "httpclient_delete",
            "httpclient_request_generic",
            "fetch_api_native",
            "axios_wrapper",
            "vue_composition_axios",
            "react_useeffect_fetch",
            "param_ts_interface",
            "param_generic_type_annotation",
            "param_httpparams_chain",
            "param_urlsearchparams",
            "param_formgroup",
            "param_backward_taint",
            "inter_proc_constructor_injection",
            "xhr_interception",
            "fetch_interception",
            "webpack_registry_unnavigated",
            "dynamic_button_click",
            "dynamic_menu_expand",
            "dynamic_form_submit",
            "dynamic_hover",
            "lazy_loaded_chunk",
            "dynamic_worker_blob",
            "federation_runtime_manifest",
            "websocket_connection_url",
            "websocket_payload_sample",
            "websocket_static",
            "graphql_endpoint_heuristic",
            "graphql_introspection",
            "graphql_query_resolver",
            "graphql_mutation_resolver",
            "graphql_subscription_resolver",
            "graphql_introspection_disabled",
            "openapi_discovery",
            "openapi_path_enumeration",
            "spring_actuator_mappings",
            "indexeddb_api_cache",
            "indexeddb_config",
            "indexeddb_session",
            "backend_sourcemap_server_routes",
            "soap_bridge_dynamic",
            "noise_momentjs",
            "noise_exceljs",
            "noise_angular_compiler",
            "noise_pdfjs",
            "noise_nodejs_streams",
            "noise_template_literal_artifacts",
            "noise_react_component_names",
            "noise_router_navigation",
            "auth_form_login",
            "auth_browser_driven",
            "auth_totp_mfa",
            "auth_bearer_injection",
            "auth_gated_endpoint",
            "dynamic_worker_fetch"
          ],
          "description": "what the case was built to exercise (docs/TECHNIQUE_REFERENCE.md)"
        },
        "discovery_class": {
          "enum": [
            "html_literal",
            "bundle_literal",
            "bundle_composed",
            "sourcemap_literal",
            "sourcemap_composed",
            "runtime_data",
            "graphql_client_operation",
            "graphql_sourcemap_operation",
            "graphql_introspection_only",
            "probe_only"
          ],
          "description": "derived from the served artifacts by build_manifest.py"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "html": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form"
              ],
              "properties": {
                "form": {
                  "enum": [
                    "literal",
                    "composed",
                    "operation",
                    "runtime"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "repo path (or map::source) :line:col, 1-based"
                },
                "data_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "served data file the runtime piece comes from"
                }
              }
            },
            "bundle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form"
              ],
              "properties": {
                "form": {
                  "enum": [
                    "literal",
                    "composed",
                    "operation",
                    "runtime"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "repo path (or map::source) :line:col, 1-based"
                },
                "data_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "served data file the runtime piece comes from"
                }
              }
            },
            "sourcemap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form"
              ],
              "properties": {
                "form": {
                  "enum": [
                    "literal",
                    "composed",
                    "operation",
                    "runtime"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "repo path (or map::source) :line:col, 1-based"
                },
                "data_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "served data file the runtime piece comes from"
                }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form"
              ],
              "properties": {
                "form": {
                  "enum": [
                    "literal",
                    "composed",
                    "operation",
                    "runtime"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "repo path (or map::source) :line:col, 1-based"
                },
                "data_source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "served data file the runtime piece comes from"
                }
              }
            }
          }
        },
        "present_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "html",
              "bundle",
              "sourcemap",
              "runtime",
              "introspection",
              "probe"
            ]
          }
        },
        "exclusive": {
          "type": "boolean"
        },
        "reachability": {
          "enum": [
            "served",
            "external",
            "probe"
          ],
          "description": "served by the benchmark; on a non-routable host by design; or served but referenced by no client code"
        },
        "auth_required": {
          "type": "boolean"
        },
        "auth_method": {
          "enum": [
            "none",
            "form",
            "bearer",
            "totp"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Parameter"
          }
        },
        "security_relevant": {
          "type": "boolean"
        },
        "security_finding_type": {
          "enum": [
            "staging_server_url",
            "oauth_token_endpoint",
            "auth_endpoint",
            "internal_ip_address",
            "admin_crud_endpoint",
            "management_endpoint_exposure",
            "legacy_attack_surface",
            "graphql_resolver_exposure",
            "websocket_realtime_surface",
            "none"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "minified_location": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^.+:\\d+:\\d+$"
        },
        "discovery_notes": {
          "type": "string",
          "minLength": 1
        },
        "graphql": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_type",
            "operation"
          ],
          "properties": {
            "operation_type": {
              "enum": [
                "query",
                "mutation",
                "subscription"
              ]
            },
            "operation": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "design_technique",
        "served"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AS-[A-Z]-\\d{3}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "design_technique": {
          "enum": [
            "script_tag_standard",
            "html_attr_onclick",
            "html_attr_ng_include",
            "html_attr_formaction",
            "link_preload",
            "link_modulepreload",
            "dynamic_import_inline",
            "web_worker_constructor",
            "noscript_tag",
            "commented_script",
            "module_federation_remote_entry",
            "module_federation_html_parse",
            "sourcemap_probe_standard",
            "sourcemap_url_directive",
            "ts_service_file_recovery",
            "environment_ts_recovery",
            "jsx_source_recovery",
            "sourcemap_restricted",
            "backend_sourcemap_recovery",
            "auth_service_recovery",
            "url_concat_direct",
            "url_template_literal",
            "url_variable_based",
            "url_object_property_chain",
            "url_service_method_delegation",
            "url_array_assembly",
            "url_conditional_feature_flag",
            "inter_proc_constructor_single",
            "inter_proc_constructor_multi",
            "inter_proc_factory_return",
            "obfuscated_string_array",
            "inter_proc_cycle_detection",
            "httpclient_get",
            "httpclient_post",
            "httpclient_put",
            "httpclient_patch",
            "httpclient_delete",
            "httpclient_request_generic",
            "fetch_api_native",
            "axios_wrapper",
            "vue_composition_axios",
            "react_useeffect_fetch",
            "param_ts_interface",
            "param_generic_type_annotation",
            "param_httpparams_chain",
            "param_urlsearchparams",
            "param_formgroup",
            "param_backward_taint",
            "inter_proc_constructor_injection",
            "xhr_interception",
            "fetch_interception",
            "webpack_registry_unnavigated",
            "dynamic_button_click",
            "dynamic_menu_expand",
            "dynamic_form_submit",
            "dynamic_hover",
            "lazy_loaded_chunk",
            "dynamic_worker_blob",
            "federation_runtime_manifest",
            "websocket_connection_url",
            "websocket_payload_sample",
            "websocket_static",
            "graphql_endpoint_heuristic",
            "graphql_introspection",
            "graphql_query_resolver",
            "graphql_mutation_resolver",
            "graphql_subscription_resolver",
            "graphql_introspection_disabled",
            "openapi_discovery",
            "openapi_path_enumeration",
            "spring_actuator_mappings",
            "indexeddb_api_cache",
            "indexeddb_config",
            "indexeddb_session",
            "backend_sourcemap_server_routes",
            "soap_bridge_dynamic",
            "noise_momentjs",
            "noise_exceljs",
            "noise_angular_compiler",
            "noise_pdfjs",
            "noise_nodejs_streams",
            "noise_template_literal_artifacts",
            "noise_react_component_names",
            "noise_router_navigation",
            "auth_form_login",
            "auth_browser_driven",
            "auth_totp_mfa",
            "auth_bearer_injection",
            "auth_gated_endpoint",
            "dynamic_worker_fetch"
          ]
        },
        "served": {
          "type": "boolean"
        }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "location",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "enum": [
            "query",
            "body",
            "path",
            "header",
            "graphql_arg"
          ]
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
